{
  "name": "loom-code",
  "version": "0.1.0",
  "description": "Local JavaScript coding agent with a TUI, durable sessions, project memory, sandboxed execution, and Vercel AI Gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crapthings/loom-code.git"
  },
  "homepage": "https://github.com/crapthings/loom-code#readme",
  "bugs": {
    "url": "https://github.com/crapthings/loom-code/issues"
  },
  "type": "module",
  "private": true,
  "exports": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "docs/architecture.md",
    "docs/sandbox.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/releasing.md",
    ".env.example",
    "AGENTS.md"
  ],
  "keywords": [
    "ai-agent",
    "coding-agent",
    "cli",
    "tui",
    "javascript",
    "nodejs",
    "agent-orchestration",
    "llm",
    "vercel-ai-gateway",
    "sandbox",
    "developer-tools"
  ],
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "loom": "bin/loom.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node bin/loom.js",
    "lint": "node scripts/lint.js",
    "test": "node --test test/*.test.js",
    "check": "pnpm run lint && pnpm test",
    "check:package": "node scripts/check-package.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "standard": "17.1.2"
  }
}
